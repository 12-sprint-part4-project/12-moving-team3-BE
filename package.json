{
  "name": "12-moving-team3-be",
  "version": "1.0.0",
  "description": "```text\r src\r ├── constants\r │   └── errorCodes.ts\r ├── controllers\r │   └── ...\r ├── middlewares\r │   └── errorHandler.ts\r ├── repositories\r │   └── ...\r ├── routes\r │   └── ...\r ├── services\r │   └── ...\r ├── utils\r │   └── AppError.ts\r └── app.ts\r ```",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc && npm run sentry:sourcemaps",
    "test": "npm run build && node --test dist/controllers/admin-auth.controller.test.js dist/repositories/admin-review.repository.test.js dist/schemas/admin-report.schema.test.js dist/schemas/admin-review.schema.test.js dist/services/admin-auth.service.test.js dist/services/admin-review.service.test.js",
    "start": "node dist/app.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:create": "ts-node scripts/create-admin.ts",
    "banned-words:seed": "ts-node scripts/seed-banned-words.ts",
    "banned-words:index": "ts-node scripts/index-banned-words.ts",
    "movers:index-embeddings": "ts-node scripts/index-mover-embeddings.ts",
    "movers:seed-demo-vector": "ts-node scripts/seed-demo-vector-movers.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ssh": "dotenv -- bash -c 'ssh -i \"$SSH_KEY_PATH\" -L 15432:$DB_HOST:5432 $EC2_USER@$EC2_HOST'",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org irum-0d --project node-express ./dist && sentry-cli sourcemaps upload --org irum-0d --project node-express ./dist"
  },
  "repository": {
    "type": "git",
