# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

# App
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Admin FE origin(s) for credentialed cookie requests (comma-separated)
CORS_ORIGIN=http://localhost:3001

# User/Driver JWT — 관리자 인증용 secret과 절대 공유하지 않는다.
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Admin JWT — 일반 유저/기사 인증용 secret과 절대 공유하지 않는다.
ADMIN_JWT_ACCESS_SECRET=replace-with-long-random-access-secret
ADMIN_JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# Admin bootstrap (scripts/create-admin.ts)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# AWS S3 (프로필·게시글 이미지 업로드)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 프로필·게시글 이미지 공개 URL (둘 중 하나. CDN 우선)
CDN_BASE_URL=
S3_PUBLIC_BASE_URL=

# Kakao OAuth (FE Redirect URI로 code 수신 후 BE에서 토큰 교환)
# redirect_uri는 카카오 콘솔 등록값 · FE authorize 요청값 · 여기 값이 모두 같아야 한다.
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
