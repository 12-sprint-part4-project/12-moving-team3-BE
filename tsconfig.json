{
  "compilerOptions": {
    // 또는 더 최신 버전
    "target": "ES2016",

    // Node.js 환경
    "module": "CommonJS",

    // 컴파일 결과물 경로
    "outDir": "./dist",

    // 타입스크립트 소스코드 루트
    "rootDir": "./src",

    "strict": true,

    // CommonJS 모듈 호환성
    "esModuleInterop": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 디버깅용 소스맵 생성
    "sourceMap": true,

    "inlineSources": true,

    // Set `sourceRoot` to  "/" to strip the build path prefix
    // from generated source code references.
    // This improves issue grouping in Sentry.
    "sourceRoot": "/"
  },
  "include": ["src/**/*"], // 컴파일 대상 폴더
  "exclude": ["node_modules"] // 컴파일 제외 폴더
}
